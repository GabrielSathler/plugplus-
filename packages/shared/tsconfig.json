{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    // Os testes rodam direto do fonte com o type-stripping nativo do Node, que
    // exige a extensao real (`./money.ts`). Estas duas flags deixam o fonte
    // usar `.ts` e o tsc reescrever para `.js` no dist consumido por API e Web.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["dist", "src/**/*.test.ts"]
}
