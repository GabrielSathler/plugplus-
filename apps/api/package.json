{
  "name": "@finflow/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS do FinFlow",
  "scripts": {
    "prebuild": "tsc -p ../../packages/shared/tsconfig.json",
    "predev": "tsc -p ../../packages/shared/tsconfig.json",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "prisma db push --skip-generate",
    "db:generate": "prisma generate",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:reset": "node -e \"require('fs').rmSync('prisma/finflow.db',{force:true})\" && npm run db:generate && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@finflow/shared": "*",
    "@nestjs/common": "^11.0.10",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.10",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/swagger": "^11.0.3",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.5",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3"
  }
}
