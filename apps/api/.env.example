# Copie para `.env` e ajuste. O arquivo real fica fora do versionamento.

# Supabase (PostgreSQL).
# Senha com caractere especial precisa vir percent-encoded.
DATABASE_URL="postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres"

PORT=3333
CORS_ORIGIN="http://localhost:5273"
APP_URL="http://localhost:5273"

JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="7d"

# ATENCAO: com "true", qualquer requisicao SEM token e atendida como se fosse a
# dona da conta. Existe so para o protótipo abrir sem tela de login.
# Precisa ser "false" em qualquer ambiente compartilhado.
DEV_AUTO_LOGIN="true"
DEMO_USER_EMAIL="marina@familia.com"

# --- Open Finance ---------------------------------------------------------
# Sem credenciais, a aplicacao sobe com o provider de sandbox.
# INTEGRATION_PROVIDER=sandbox forca o sandbox mesmo com credencial presente.
# PLUGGY_CLIENT_ID=""
# PLUGGY_CLIENT_SECRET=""
# PLUGGY_WEBHOOK_SECRET=""

# --- Notificacoes ---------------------------------------------------------
# Sem credenciais, push e e-mail apenas registram em log (nada sai da maquina).
# NOTIFICATIONS_PROVIDER=sandbox forca o modo log mesmo com credencial.

# Firebase Cloud Messaging (HTTP v1). Extraia do JSON da conta de servico.
# A chave privada vem com quebras de linha escapadas: mantenha os \n literais.
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# Remetente de e-mail transacional (Resend por padrao).
# RESEND_API_KEY=""
# EMAIL_FROM="Cardinal <avisos@seudominio.com.br>"
